# Copie para backend/.env e ajuste os valores locais.

ENVIRONMENT=development

# postgresql:// é convertido automaticamente para o driver psycopg 3.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workout_planner

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Lista JSON com as origens liberadas no CORS.
CORS_ORIGINS=["http://localhost:4200"]
